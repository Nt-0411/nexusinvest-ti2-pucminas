# Copie este arquivo para .env e preencha com os seus valores.
# O .env não é versionado — nenhuma credencial entra no repositório.
#
# Alternativamente, defina os mesmos nomes como variáveis de ambiente
# do sistema ou como -D na JVM (ex.: -DNEXUS_DB_PASSWORD=segredo).

# --- Banco de dados PostgreSQL (obrigatório) ---
NEXUS_DB_HOST=localhost
NEXUS_DB_PORT=5432
NEXUS_DB_NAME=nexus
NEXUS_DB_USER=postgres
NEXUS_DB_PASSWORD=

# --- Porta do servidor web (opcional, padrão 6789) ---
NEXUS_PORT=6789

# --- brapi.dev: cotações da B3 usadas no dashboard, simulador e quiz ---
# Token gratuito em https://brapi.dev
NEXUS_BRAPI_TOKEN=

# --- newsdata.io: sincronização das notícias do mercado (opcional) ---
# Chave gratuita em https://newsdata.io
# Sem ela, a tela de notícias mostra apenas o que já está no banco.
NEXUS_NEWSDATA_API_KEY=

# --- Azure AI Content Safety: moderação das mensagens do fórum (opcional) ---
# Sem estas duas variáveis a moderação fica desligada e as mensagens passam direto.
NEXUS_AZURE_CONTENT_SAFETY_ENDPOINT=
NEXUS_AZURE_CONTENT_SAFETY_KEY=
